# DataWorks skill 凭证配置
# 用法:cp config.example.env .env  然后取消注释并填写;切勿提交或分享 .env。
# 优先级:进程环境变量 > 本 .env 文件 > 默认值。

# --- AccessKey(必填)---
# 统一使用 DATAWORKS_* 或阿里云 CLI 标准命名 ALIBABA_CLOUD_*(二选一即可):
#DATAWORKS_ACCESS_KEY_ID=你的AccessKeyId
#DATAWORKS_ACCESS_KEY_SECRET=你的AccessKeySecret
#ALIBABA_CLOUD_ACCESS_KEY_ID=你的AccessKeyId
#ALIBABA_CLOUD_ACCESS_KEY_SECRET=你的AccessKeySecret

# --- 区域(可选)---
# 回退 ALIBABA_CLOUD_REGION_ID,默认 cn-shanghai
#DATAWORKS_REGION_ID=cn-shanghai
# 如需覆盖 endpoint(VPC/金融云),取消下行注释:
#DATAWORKS_ENDPOINT=dataworks.cn-shanghai.aliyuncs.com

# --- 工作空间(可先留空)---
# DataWorks 数字 projectId,可先 `python3 scripts/dwcli.py project list` 查询后再填
#DATAWORKS_PROJECT_ID=

# --- 环境(可选,默认 PROD)---
#DATAWORKS_PROJECT_ENV=PROD
